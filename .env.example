POSTGRES_DB=agenda_arena
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5433

# Segurança (JWT). Gere um segredo com: openssl rand -base64 48  (mínimo 32 bytes)
JWT_SECRET=change_me_with_at_least_32_bytes_of_random_data
JWT_EXPIRATION_MINUTES=15
REFRESH_EXPIRATION_DAYS=30

# Administrador da plataforma (criado na subida se ainda não existir; senha mínima de 8 caracteres)
PLATFORM_ADMIN_NAME=Platform Admin
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PHONE=00000000000
PLATFORM_ADMIN_PASSWORD=change_me_please

# CORS: origens do front-end, separadas por vírgula
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Swagger UI e /v3/api-docs (desligue em produção)
API_DOCS_ENABLED=true

# E-mails transacionais (confirmação de reserva etc.). Desligado por padrão: só registra no log.
# Em desenvolvimento: MAIL_ENABLED=true e `docker compose up -d` sobe o Mailpit (SMTP 1025; veja os e-mails em http://localhost:8025).
MAIL_ENABLED=false
MAIL_FROM=no-reply@agendaarena.local
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
# Portas do Mailpit no docker-compose (se mudar MAIL_PORT, mude MAILPIT_SMTP_PORT junto)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Limite de requisições nas rotas públicas. Atrás de proxy (Caddy) ligue TRUST_FORWARDED_HEADERS=true,
# mas SÓ se a API for alcançável apenas pelo proxy (senão o cliente forja o X-Forwarded-For).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_TRUST_FORWARDED_HEADERS=false
