POSTGRES_DB=agenda_arena
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5433

# Segurança (JWT). Gere um segredo com: openssl rand -base64 48  (mínimo 32 bytes)
JWT_SECRET=change_me_with_at_least_32_bytes_of_random_data
JWT_EXPIRATION_MINUTES=60

# Administrador da plataforma (criado na subida se ainda não existir; senha mínima de 8 caracteres)
PLATFORM_ADMIN_NAME=Platform Admin
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PHONE=00000000000
PLATFORM_ADMIN_PASSWORD=change_me_please

# CORS: origens do front-end, separadas por vírgula
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Swagger UI e /v3/api-docs (desligue em produção)
API_DOCS_ENABLED=true
