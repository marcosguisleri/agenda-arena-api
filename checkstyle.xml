<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Regras iniciais do Agenda Arena API.
  Filosofia: poucas regras, todas em nível "warning", escolhidas para NÃO gerar ruído no código atual.
  Deliberadamente fora (o código existente as viola de forma consistente):
    - AvoidStarImport (há jakarta.persistence.* e web.bind.annotation.*)
    - LineLength (construtores/assinaturas longos)
    - NewlineAtEndOfFile, ImportOrder/CustomImportOrder, JavadocMethod/MissingJavadoc*
  Para endurecer depois: troque o "severity" abaixo para "error" (o plugin falha o build só com "error").
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="warning"/>
    <property name="fileExtensions" value="java"/>

    <module name="FileTabCharacter">
        <property name="eachLine" value="false"/>
    </module>


    <module name="TreeWalker">
        <!-- Evita saída de console e stack trace solto: use logger/exceções de domínio. -->
        <module name="RegexpSinglelineJava">
            <property name="format" value="System\.(out|err)\.print"/>
            <property name="message" value="Não use System.out/err; use logger."/>
            <property name="ignoreComments" value="true"/>
        </module>
        <module name="RegexpSinglelineJava">
            <property name="format" value="\.printStackTrace\(\)"/>
            <property name="message" value="Não use printStackTrace(); registre com logger."/>
            <property name="ignoreComments" value="true"/>
        </module>

        <!-- Imports -->
        <module name="UnusedImports"/>
        <module name="RedundantImport"/>
        <module name="IllegalImport"/>

        <!-- Nomes (convenções Java padrão) -->
        <module name="PackageName">
            <property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
        </module>
        <module name="TypeName"/>
        <module name="MethodName"/>
        <module name="MemberName"/>
        <module name="ParameterName"/>
        <module name="LocalVariableName"/>
        <module name="ConstantName"/>
        <module name="StaticVariableName"/>

        <!-- Corretude / legibilidade -->
        <module name="ModifierOrder"/>
        <module name="UpperEll"/>
        <module name="ArrayTypeStyle"/>
        <module name="EmptyStatement"/>
        <module name="EqualsHashCode"/>
        <module name="MultipleVariableDeclarations"/>
        <module name="OneStatementPerLine"/>
        <module name="SimplifyBooleanExpression"/>
        <module name="SimplifyBooleanReturn"/>
        <module name="FallThrough"/>
        <module name="EmptyCatchBlock">
            <property name="exceptionVariableName" value="expected|ignored"/>
        </module>
        <module name="NeedBraces"/>
        <module name="LeftCurly"/>
        <module name="RightCurly"/>
    </module>
</module>
